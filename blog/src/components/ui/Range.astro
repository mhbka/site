---
import type { HTMLAttributes } from 'astro/types';

type Props = HTMLAttributes<'input'>;

const { class: className, ...props } = Astro.props;
---

<input type="range" class:list={['ui-range', className]} {...props} />

<style>
	.ui-range {
		width: 100%;
		height: 1.25rem;
		margin: 0;
		padding: 0;
		appearance: none;
		background: transparent;
		cursor: ew-resize;
	}
	.ui-range::-webkit-slider-runnable-track {
		height: 0.4rem;
		border: var(--border-width) solid var(--color-subtle);
		border-radius: var(--radius-control);
		background: var(--color-page-background);
		box-shadow: inset 0 0 0 1px var(--color-muted);
	}
	.ui-range::-moz-range-track {
		height: 0.4rem;
		border: var(--border-width) solid var(--color-subtle);
		border-radius: var(--radius-control);
		background: var(--color-page-background);
		box-shadow: inset 0 0 0 1px var(--color-muted);
	}
	.ui-range::-webkit-slider-thumb {
		width: 1rem;
		height: 1rem;
		margin-top: calc((0.4rem - 1rem) / 2);
		appearance: none;
		border: var(--border-width) solid var(--color-heading);
		border-radius: 0;
		background: var(--color-accent);
		box-shadow: 2px 2px 0 var(--color-subtle), 0 0 0 2px var(--color-page-background);
		transition: transform 0.15s ease, box-shadow 0.15s ease;
	}
	.ui-range::-moz-range-thumb {
		width: 0.875rem;
		height: 0.875rem;
		border: var(--border-width) solid var(--color-heading);
		border-radius: 0;
		background: var(--color-accent);
		box-shadow: 2px 2px 0 var(--color-subtle), 0 0 0 2px var(--color-page-background);
		transition: transform 0.15s ease, box-shadow 0.15s ease;
	}
	.ui-range:hover::-webkit-slider-thumb,
	.ui-range:focus-visible::-webkit-slider-thumb {
		transform: scale(1.15) rotate(45deg);
		box-shadow: 2px 2px 0 var(--color-subtle), 0 0 0 var(--focus-ring-width) var(--color-accent);
	}
	.ui-range:hover::-moz-range-thumb,
	.ui-range:focus-visible::-moz-range-thumb {
		transform: scale(1.15) rotate(45deg);
		box-shadow: 2px 2px 0 var(--color-subtle), 0 0 0 var(--focus-ring-width) var(--color-accent);
	}
	.ui-range:focus-visible { outline: none; }
	@media (prefers-reduced-motion: reduce) {
		.ui-range::-webkit-slider-thumb,
		.ui-range::-moz-range-thumb { transition: none; }
	}
</style>
