---
import type { Post } from '../../lib/models/posts.ts';
import { getPostEditorLabels } from '../../lib/post-editor.ts';
import Button from '../ui/Button.astro';
import FormattedDate from '../FormattedDate.astro';
import Input from '../ui/Input.astro';
import TagInput from '../TagInput.astro';

interface Props {
	post?: Post;
}

const { post } = Astro.props;
const createdAt = post ? new Date(post.createdAt) : undefined;
const updatedAt = post ? new Date(post.updatedAt) : undefined;
const labels = getPostEditorLabels(post?.status);
---

<form class="post-editor" data-post-editor data-post-id={post?.id} data-initial-tags={JSON.stringify(post?.tags ?? [])}>
	<header class="post-header">
		<p class="post-meta">{labels.state}</p>
		<Input id="post-title" class="post-title" name="title" placeholder="Title" required maxlength="200" autocomplete="off" value={post?.title ?? ''} aria-label="Post title" />
		<div class="post-meta">
			{createdAt && <div class="post-metadata">created on <FormattedDate date={createdAt} includeTime /></div>}
			{updatedAt && <div class="post-metadata">last updated on <FormattedDate date={updatedAt} includeTime /></div>}
		</div>
		<hr />
	</header>

	<div class="post-properties">
		<TagInput id="post-tags" name="tags" label="Tags" initialTags={post?.tags ?? []} managed={false} />
		<datalist id="post-tag-suggestions"></datalist>
		<details class="post-settings">
			<summary>Post settings</summary>
			<Input id="post-slug" name="slug" placeholder="Slug" autocomplete="off" value={post?.slug ?? ''} aria-describedby="slug-help" />
			<p id="slug-help" class="editor-help">Leave blank to generate one from the title. Use letters, numbers, and hyphens only.</p>
		</details>
	</div>

	<div class="editor-surface" data-editor-surface>
		<div id="post-content" class="markdown-content" aria-label="Post content" data-initial-content={post?.contentMd ?? ''}></div>
	</div>

	<div class="editor-actions">
		<Button type="submit">{labels.submit}</Button>
		<p class="editor-status" data-editor-status role="status" aria-live="polite"></p>
	</div>
</form>

<script>
	import './post-editor.ts';
</script>

<style>
	.post-editor {
		display: grid;
		gap: 1rem;
	}
	:global(.post-title)::placeholder,
	.tag-input :global(.ui-input)::placeholder {
		color: var(--color-muted);
		opacity: 1;
	}
	.post-properties {
		display: grid;
		gap: 0.75rem;
	}
	.tag-input {
		display: flex;
		flex-wrap: wrap;
		gap: 0.4rem;
		align-items: center;
		padding: 0.4rem;
	}
	.tag-input:focus-within {
		border-radius: var(--radius-focus);
		box-shadow: 0 0 0 var(--focus-ring-width) var(--color-accent);
	}
	.tag-input :global(.ui-input) {
		min-width: 12rem;
		flex: 1;
		padding: 0.3rem;
		border: 0;
		outline: 0;
		background: var(--color-transparent);
	}
	.tag-list {
		display: flex;
		flex-wrap: wrap;
		gap: 0.4rem;
		margin: 0;
		padding: 0;
		list-style: none;
	}
	.tag {
		padding: 0.2rem 0.55rem;
		border-radius: var(--radius-tag);
		background: var(--color-subtle);
		color: var(--color-text);
		font-size: 0.8rem;
	}
	.editor-surface {
		position: relative;
		min-height: 24rem;
		border-radius: var(--radius-focus);
	}
	.editor-surface :global(.milkdown) {
		min-height: 24rem;
		padding: 0;
	}
	.editor-surface :global(.ProseMirror) {
		outline: 0;
	}
	.editor-surface :global(.ProseMirror-selectednode) {
		outline: var(--focus-ring-width) solid var(--color-accent);
		outline-offset: 2px;
	}
	.post-settings {
		color: var(--color-muted);
		font-size: 0.8rem;
	}
	.post-settings summary { cursor: pointer; }
	.post-settings :global(.ui-input) { display: block; margin-top: 0.75rem; }
	.post-settings :global(.ui-input) { width: 100%; }
	.editor-help,
	.editor-status {
		margin: 0;
		font-size: 0.8rem;
	}
	.editor-actions {
		display: flex;
		align-items: center;
		gap: 1rem;
	}
	:global(.image-uploading) {
		color: var(--color-muted);
	}
</style>
