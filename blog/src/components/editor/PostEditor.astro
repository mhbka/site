---
import type { Post } from '../../lib/models/posts.ts';
import Button from '../ui/Button.astro';
import FormattedDate from '../FormattedDate.astro';
import Input from '../ui/Input.astro';interface Props {
	post?: Post;
}

const { post } = Astro.props;
const createdAt = post ? new Date(post.createdAt) : undefined;
const updatedAt = post ? new Date(post.updatedAt) : undefined;
---

<form class="post-editor" data-post-editor data-post-id={post?.id} data-initial-tags={JSON.stringify(post?.tags ?? [])}>
	<header class="post-header">
		<p class="post-meta">[Draft]</p>
		<Input id="post-title" class="post-title" name="title" placeholder="Title" required maxlength="200" autocomplete="off" value={post?.title ?? ''} aria-label="Post title" />
		<div class="post-meta">
			{createdAt && <div class="post-metadata">Created on <FormattedDate date={createdAt} includeTime /></div>}
			{updatedAt && <div class="post-metadata">Last updated on <FormattedDate date={updatedAt} includeTime /></div>}
		</div>
		<hr />
	</header>

	<div class="post-properties">
		<div class="tag-input" data-tag-input>
			<ul class="tag-list" data-tag-list aria-label="Post tags"></ul>
			<Input id="post-tags" name="tags" placeholder="Tags" autocomplete="off" aria-label="Post tags" list="post-tag-suggestions" />
			<datalist id="post-tag-suggestions"></datalist>
		</div>
		<details class="post-settings">
			<summary>Post settings</summary>
			<Input id="post-slug" name="slug" placeholder="Slug" autocomplete="off" value={post?.slug ?? ''} aria-describedby="slug-help" />
			<p id="slug-help" class="editor-help">Leave blank to generate one from the title. Use letters, numbers, and hyphens only.</p>
		</details>
	</div>

	<div class="editor-surface" data-editor-surface>
		<div id="post-content" class="markdown-content" aria-label="Post content" data-initial-content={post?.contentMd ?? ''}></div>
		<p class="content-placeholder" data-content-placeholder>Content</p>
	</div>

	<div class="editor-actions">
		<Button type="submit">Save draft</Button>
		<p class="editor-status" data-editor-status role="status" aria-live="polite"></p>
	</div>
</form>

<script>
	import { Editor, defaultValueCtx, rootCtx } from '@milkdown/kit/core';
	import { commonmark } from '@milkdown/kit/preset/commonmark';
	import { gfm } from '@milkdown/kit/preset/gfm';
	import { block } from '@milkdown/kit/plugin/block';
	import { clipboard } from '@milkdown/kit/plugin/clipboard';
	import { history as historyPlugin } from '@milkdown/kit/plugin/history';
	import { indent } from '@milkdown/kit/plugin/indent';
	import { upload } from '@milkdown/kit/plugin/upload';
	import { getMarkdown } from '@milkdown/kit/utils';
	import { nord } from '@milkdown/theme-nord';
	import { createSupabaseBrowserClient } from '../../lib/auth/supabase';
	import { blogApi } from '../../lib/api';
	import { uploadImage } from '../../lib/image-upload';
	import { addTag, normalizeTag } from '../../lib/tags';
	import { imageSelectionPlugin } from './plugins/image-selection';
	import { imageUploadPlugin } from './plugins/image-upload';

	const form = document.querySelector<HTMLFormElement>('[data-post-editor]');
	const root = document.querySelector<HTMLElement>('#post-content');
	const editorSurface = document.querySelector<HTMLElement>('[data-editor-surface]');
	const contentPlaceholder = document.querySelector<HTMLElement>('[data-content-placeholder]');
	const title = document.querySelector<HTMLInputElement>('#post-title');
	const slug = document.querySelector<HTMLInputElement>('#post-slug');
	const tagsInput = document.querySelector<HTMLInputElement>('#post-tags');
	const tagList = document.querySelector<HTMLUListElement>('[data-tag-list]');
	const tagSuggestions = document.querySelector<HTMLDataListElement>('#post-tag-suggestions');
	const button = form?.querySelector<HTMLButtonElement>('button[type="submit"]');
	const status = document.querySelector<HTMLElement>('[data-editor-status]');
	const mediaApiUrl = `${import.meta.env.BACKEND_URL.replace(/\/$/, '')}/media/uploads`;
	let postId = form?.dataset.postId;

	if (!form || !root || !editorSurface || !contentPlaceholder || !title || !slug || !tagsInput || !tagList || !button || !status) {
		throw new Error('Post editor is missing required elements.');
	}
	const editorRoot = root;
	const placeholder = contentPlaceholder;
	const slugInput = slug;

	let tags: string[] = JSON.parse(form.dataset.initialTags ?? '[]');

	function slugError(value: string) {
		return value && !/^[A-Za-z0-9-]+$/.test(value)
			? 'Slug may contain only letters, numbers, and hyphens.'
			: '';
	}

	function validateSlug() {
		const error = slugError(slugInput.value);
		slugInput.setCustomValidity(error);
		slugInput.setAttribute('aria-invalid', String(Boolean(error)));
		return error;
	}

	slugInput.addEventListener('input', validateSlug);

	function renderTags() {
		tagList?.replaceChildren(...tags.map((tag) => {
			const item = document.createElement('li');
			const removeButton = document.createElement('button');
			removeButton.type = 'button';
			removeButton.className = 'ui-button tag';
			removeButton.setAttribute('aria-label', `Remove ${tag} tag`);
			removeButton.dataset.tag = tag;
			removeButton.textContent = `${tag} Ã—`;
			item.append(removeButton);
			return item;
		}));
	}

	function commitTag() {
		if (tagsInput?.value) {
			tags = addTag(tags, tagsInput?.value);
			tagsInput.value = '';
			renderTags();
		}
	}

	renderTags();

	void blogApi.listTags().then((availableTags) => {
		tagSuggestions?.replaceChildren(...availableTags.map(({ tag, count }) => {
			const option = document.createElement('option');
			option.value = tag;
			option.label = `${count} published post${count === 1 ? '' : 's'}`;
			return option;
		}));
	}).catch(() => {
		// Tag suggestions are optional; authors can always add a new tag.
	});

	tagsInput.addEventListener('input', () => {
		tagsInput.value = normalizeTag(tagsInput.value);
	});

	tagsInput.addEventListener('keydown', (event) => {
		if (event.key === ' ' || event.key === 'Enter') {
			event.preventDefault();
			commitTag();
		}

		if (event.key === 'Backspace' && !tagsInput.value && tags.length) {
			tags = tags.slice(0, -1);
			renderTags();
		}
	});

	tagList.addEventListener('click', (event) => {
		const button = (event.target as HTMLElement).closest<HTMLButtonElement>('[data-tag]');
		if (!button?.dataset.tag) return;

		tags = tags.filter((tag) => tag !== button.dataset.tag);
		renderTags();
		tagsInput.focus();
	});

	const supabaseClient = createSupabaseBrowserClient();

	async function uploadImageFile(file: File): Promise<string> {
		if (!file.type.startsWith('image/')) throw new Error('Only image files can be uploaded.');
		if (!postId) throw new Error('Save this draft before uploading images.');

		const { data: { session } } = await supabaseClient.auth.getSession();
		if (!session) throw new Error('Please log in before uploading an image.');
		return uploadImage(file, mediaApiUrl, postId, session.access_token);
	}

	const editor = await Editor.make()
		.config((ctx) => {
			nord(ctx);
			ctx.set(rootCtx, root);
			ctx.set(defaultValueCtx, root.dataset.initialContent ?? '');
		})
		.use(commonmark)
		.use(gfm)
		.use(historyPlugin)
		.use(clipboard)
		.use(indent)
		.use(block)
		.use(upload)
		.use(imageUploadPlugin(uploadImageFile))
		.use(imageSelectionPlugin)
		.create();


	function syncContentPlaceholder() {
		const documentContent = editorRoot.querySelector<HTMLElement>('.ProseMirror');
		placeholder.hidden = Boolean(documentContent?.textContent?.trim() || documentContent?.querySelector('img'));
	}

	editorRoot.addEventListener('input', syncContentPlaceholder);
	new MutationObserver(syncContentPlaceholder).observe(editorRoot, { childList: true, characterData: true, subtree: true });
	syncContentPlaceholder();

	form.addEventListener('submit', async (event) => {
		event.preventDefault();
		commitTag();
		const contentMd = editor.action(getMarkdown()).trim();
		const postTitle = title.value.trim();
		const postSlug = slugInput.value.trim();

		if (!postTitle || !contentMd) {
			status.textContent = 'A title and content are required.';
			return;
		}
		if (validateSlug()) {
			slugInput.reportValidity();
			return;
		}

		button.disabled = true;
		status.textContent = postId ? 'Saving changes...' : 'Creating draft...';

		try {
			const { data: { session } } = await supabaseClient.auth.getSession();
			if (!session) throw new Error('Please log in before saving a post.');

			if (postId) {
				await blogApi.updatePost(postId, { title: postTitle, contentMd, slug: postSlug, tags }, session.access_token);
				status.textContent = 'Changes saved.';
			} else {
				const post = await blogApi.createPost({ title: postTitle, contentMd, slug: postSlug, tags }, session.access_token);
				postId = post.id;
				history.replaceState(null, '', `/posts/edit/${encodeURIComponent(post.id)}`);
				status.textContent = 'Draft created.';
			}
		} catch (error) {
			status.textContent = error instanceof Error ? error.message : 'Unable to save the post. Please try again.';
		} finally {
			button.disabled = false;
		}
	});
</script>

<style>
	.post-editor {
		display: grid;
		gap: 1rem;
	}
	:global(.post-title)::placeholder,
	.tag-input :global(.ui-input)::placeholder,
	.content-placeholder {
		color: var(--color-muted);
		opacity: 1;
	}
	.post-properties {
		display: grid;
		gap: 0.75rem;
	}
	.tag-input {
		display: flex;
		flex-wrap: wrap;
		gap: 0.4rem;
		align-items: center;
		padding: 0.4rem;
	}
	.tag-input:focus-within {
		border-radius: var(--radius-focus);
		box-shadow: 0 0 0 var(--focus-ring-width) var(--color-accent);
	}
	.tag-input :global(.ui-input) {
		min-width: 12rem;
		flex: 1;
		padding: 0.3rem;
		border: 0;
		outline: 0;
		background: var(--color-transparent);
	}
	.tag-list {
		display: flex;
		flex-wrap: wrap;
		gap: 0.4rem;
		margin: 0;
		padding: 0;
		list-style: none;
	}
	.tag {
		padding: 0.2rem 0.55rem;
		border-radius: var(--radius-tag);
		background: var(--color-subtle);
		color: var(--color-text);
		font-size: 0.8rem;
	}
	.editor-surface {
		position: relative;
		min-height: 24rem;
		border-radius: var(--radius-focus);
		overflow: hidden;
	}
	.editor-surface :global(.milkdown) {
		min-height: 24rem;
		padding: 0;
	}
	.editor-surface :global(.ProseMirror) {
		outline: 0;
	}
	.editor-surface :global(.ProseMirror-selectednode) {
		outline: var(--focus-ring-width) solid var(--color-accent);
		outline-offset: 2px;
	}
	.post-settings {
		color: var(--color-muted);
		font-size: 0.8rem;
	}
	.post-settings summary { cursor: pointer; }
	.post-settings :global(.ui-input) { display: block; margin-top: 0.75rem; }
	.post-settings :global(.ui-input) { width: 100%; }
	.content-placeholder {
		position: absolute;
		top: 0;
		left: 0;
		margin: 0;
		pointer-events: none;
	}
	.editor-help,
	.editor-status {
		margin: 0;
		font-size: 0.8rem;
	}
	.editor-actions {
		display: flex;
		align-items: center;
		gap: 1rem;
	}
	:global(.image-uploading) {
		color: var(--color-muted);
	}
</style>
