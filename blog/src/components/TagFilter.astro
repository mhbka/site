---
import Link from './ui/Link.astro';
import type { TagSummary } from '../lib/models/tags.ts';

interface Props {
	tags: TagSummary[];
	selectedTag?: string;
}

const { tags, selectedTag } = Astro.props;
---

{tags.length > 0 && (
	<nav class="tag-filter" aria-label="Filter posts by tag" data-tag-filter>
		<Link class:list={['tag-filter__tag', !selectedTag && 'tag-filter__tag--selected']} href="/blog/" data-tag="">all</Link>
		{tags.map(({ tag, count }) => (
			<Link class:list={['tag-filter__tag', selectedTag === tag && 'tag-filter__tag--selected']} href={`/blog/?tag=${encodeURIComponent(tag)}`} data-tag={tag}>
				#{tag} <span aria-label={`${count} posts`}>({count})</span>
			</Link>
		))}
	</nav>
)}

<script>
	const filter = document.querySelector<HTMLElement>('[data-tag-filter]');

	function currentTag() {
		return new URL(window.location.href).searchParams.get('tag') ?? undefined;
	}

	function updateSelection(tag: string | undefined) {
		filter?.querySelectorAll<HTMLAnchorElement>('[data-tag]').forEach((link) => {
			link.classList.toggle('tag-filter__tag--selected', (link.dataset.tag || undefined) === tag);
		});
	}

	function filterPosts(tag: string | undefined) {
		updateSelection(tag);
		document.dispatchEvent(new CustomEvent('posts:filter', { detail: tag }));
	}

	filter?.addEventListener('click', (event) => {
		const link = (event.target as HTMLElement).closest<HTMLAnchorElement>('[data-tag]');
		if (!link || event.metaKey || event.ctrlKey || event.shiftKey || event.altKey) return;

		event.preventDefault();
		const url = new URL(link.href);
		window.history.pushState(null, '', url);
		filterPosts(link.dataset.tag || undefined);
	});

	window.addEventListener('popstate', () => filterPosts(currentTag()));
</script>

<style>
	.tag-filter { display: flex; flex-wrap: wrap; gap: 0.5rem; margin: 0 0 2rem; }
	.tag-filter__tag { color: var(--color-muted); text-decoration: none; }
	.tag-filter__tag--selected { color: var(--color-accent); text-decoration: underline; }
</style>
