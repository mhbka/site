---
import type { HTMLAttributes } from 'astro/types';
import Button from './ui/Button.astro';
interface Props extends HTMLAttributes<'button'> {
	isLoggedIn?: boolean;
}

const { class: className, isLoggedIn = false, ...props } = Astro.props;
const buttonText = isLoggedIn ? 'Logout' : 'Login';
---

<script>
	import { createSupabaseBrowserClient } from '../lib/auth/supabase';

	const supabaseClient = createSupabaseBrowserClient();
	const loginButton = document.querySelector<HTMLButtonElement>('[data-login-button]');

	const buttonCallback = loginButton?.dataset.loggedIn === 'true'
		? async () => {
			await supabaseClient.auth.signOut();
			location.reload();
		}
		: async () => await supabaseClient.auth.signInWithOAuth({
			provider: 'google',
			options: {
				redirectTo: `${window.location.origin}/api/auth/callback`
			}
		});

	loginButton?.addEventListener('click', buttonCallback);
</script>

<Button data-login-button data-logged-in={isLoggedIn} class:list={[className]} {...props}>
	{buttonText}
</Button>
<style>
	button {
		display: inline-block;
		text-decoration: none;
	}
	button.active {
		font-weight: bolder;
		text-decoration: underline;
	}
</style>
