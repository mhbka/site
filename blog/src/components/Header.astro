---
import HeaderLink from './HeaderLink.astro';
import LoginButton from './LoginButton.astro';
import ThemeSelector from './ThemeSelector.astro';

interface Props {
	isLoggedIn?: boolean;
}

const { isLoggedIn = false } = Astro.props;
---

<header class="site-header">
	<nav>
		<div class="internal-links">
			<HeaderLink href="/">home</HeaderLink>
			<HeaderLink href="/me">me</HeaderLink>
			<HeaderLink href="/blog">blog</HeaderLink>
			<details class="nav-dropdown">
				<summary>nonsense</summary>
				<div class="nav-dropdown__items">
					<HeaderLink href="/nonsense/bash-org">bash.org quote picker</HeaderLink>
					<HeaderLink href="/nonsense/pix">pix</HeaderLink>
				</div>
			</details>
			<ThemeSelector />
			<LoginButton isLoggedIn={isLoggedIn} />
		</div>
	</nav>
</header>
<style>
	header {
		padding: 1.5em 1em;
		background: var(--color-surface);
		box-shadow: var(--shadow-header);
	}
	nav {
		display: flex;
		flex-direction: column;
		align-items: stretch;
		gap: 1.5rem;
	}
	nav a {
		padding: 0.25em 0;
		color: var(--color-heading);
		text-decoration: none;
	}
	nav a.active {
		text-decoration: none;
		font-weight: inherit;
	}
	nav a:hover {
		font-weight: 700;
	}
	.internal-links {
		display: grid;
		gap: 0.75rem;
	}
	.nav-dropdown summary {
		cursor: pointer;
		color: var(--color-heading);
	}
	.nav-dropdown__items {
		display: grid;
		gap: 0.75rem;
		margin-top: 0.75rem;
		padding-left: 1rem;
	}
	@media (max-width: 720px) {
		header { padding: 1em; }
		nav { flex-direction: row; align-items: center; justify-content: space-between; gap: 0.5rem; }
		.internal-links { display: flex; gap: 0.75rem; }
		.nav-dropdown { position: relative; }
		.nav-dropdown__items { position: absolute; z-index: 1; min-width: max-content; padding: 0.75rem; margin-top: 0.5rem; background: var(--color-surface); box-shadow: var(--shadow-header); }
	}
</style>
