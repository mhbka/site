---
import HeaderLink from './HeaderLink.astro';
import LoginButton from './LoginButton.astro';

interface Props {
	isLoggedIn?: boolean;
}

const { isLoggedIn = false } = Astro.props;
---

<header class="site-header">
	<nav>
		<div class="internal-links">
			<HeaderLink href="/">home</HeaderLink>
			<HeaderLink href="/blog">blog</HeaderLink>
			<HeaderLink href="/about">about</HeaderLink>
		</div>
		<div class="social-links">
			<LoginButton isLoggedIn={isLoggedIn} />
		
		</div>
	</nav>
</header>
<style>
	header {
		padding: 1.5em 1em;
		background: white;
		box-shadow: 0 2px 8px rgba(var(--black), 5%);
	}
	h2 {
		margin: 0;
		font-size: 1em;
	}

	h2 a,
	h2 a.active {
		text-decoration: none;
	}
	nav {
		display: flex;
		flex-direction: column;
		align-items: stretch;
		gap: 1.5rem;
	}
	nav a {
		padding: 0.25em 0;
		color: var(--black);
		text-decoration: none;
	}
	nav a.active {
		text-decoration: none;
		font-weight: inherit;
	}
	nav a:hover {
		font-weight: 700;
	}
	.internal-links {
		display: grid;
		gap: 0.75rem;
	}
	.social-links,
	.social-links a {
		display: flex;
	}
	.social-links {
		align-items: center;
		flex-wrap: wrap;
	}
	@media (max-width: 720px) {
		header { padding: 1em; }
		nav { flex-direction: row; align-items: center; justify-content: space-between; gap: 0.5rem; }
		.internal-links { display: flex; gap: 0.75rem; }
		.social-links {
			display: none;
		}
	}
</style>
