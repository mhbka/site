---
import HeaderLink from './HeaderLink.astro';
import LoginButton from './LoginButton.astro';
import ThemeSelector from './ThemeSelector.astro';

interface Props {
	isLoggedIn?: boolean;
}

const { isLoggedIn = false } = Astro.props;
---

<header class="site-header">
	<nav>
		<div class="internal-links">
			<HeaderLink href="/">home</HeaderLink>
			<HeaderLink href="/blog">blog</HeaderLink>
			<ThemeSelector />
			<LoginButton isLoggedIn={isLoggedIn} />
		</div>
	</nav>
</header>
<style>
	header {
		padding: 1.5em 1em;
		background: var(--color-surface);
		box-shadow: var(--shadow-header);
	}
	nav {
		display: flex;
		flex-direction: column;
		align-items: stretch;
		gap: 1.5rem;
	}
	nav a {
		padding: 0.25em 0;
		color: var(--color-heading);
		text-decoration: none;
	}
	nav a.active {
		text-decoration: none;
		font-weight: inherit;
	}
	nav a:hover {
		font-weight: 700;
	}
	.internal-links {
		display: grid;
		gap: 0.75rem;
	}
	@media (max-width: 720px) {
		header { padding: 1em; }
		nav { flex-direction: row; align-items: center; justify-content: space-between; gap: 0.5rem; }
		.internal-links { display: flex; gap: 0.75rem; }
	}
</style>
