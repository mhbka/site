---
import Footer from './Footer.astro';
import Changelog from './Changelog.astro';
import Header from './Header.astro';
import PageTop from './PageTop.astro';
import PageTitle from './PageTitle.astro';

interface Props {
	isLoggedIn?: boolean;
	mainClass?: string;
	renderChangelog?: boolean;
	renderQuote?: boolean;
	title?: string;
	titleClass?: string;
}

const { isLoggedIn = false, mainClass, renderChangelog = false, renderQuote = true, title, titleClass } = Astro.props;
---

<div class="site-layout">
	<div class="site-sidebar">
		<Header isLoggedIn={isLoggedIn} />
		{renderChangelog && <Changelog />}
	</div>
	<div class="page-content">
		<PageTop><slot name="page-top" /></PageTop>
		<main class:list={['page-main', mainClass]}>
			{title && (
				<header class="page-heading">
					<PageTitle title={title} className={titleClass} />
					<hr />
				</header>
			)}
			<div class="page-body">
				<slot />
			</div>
			<hr />
		</main>
		<Footer renderQuote={renderQuote} />
	</div>
</div>
