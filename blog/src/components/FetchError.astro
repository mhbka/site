---
interface Props {
	message: string;
}

const { message } = Astro.props;
---

<section class="fetch-error" role="alert">
	<h1>something went wrong</h1>
	<p>{message}</p>
</section>

<style>
	.fetch-error {
		padding: 1.5rem;
		border: var(--border-width) solid var(--color-subtle);
		border-radius: var(--radius-panel);
		background: var(--color-surface);
	}
	.fetch-error h1,
	.fetch-error p {
		margin: 0;
	}
	.fetch-error p {
		margin-top: 0.5rem;
	}
</style>
