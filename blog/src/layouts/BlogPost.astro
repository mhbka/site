---
import BaseHead from '../components/BaseHead.astro';
import FetchError from '../components/FetchError.astro';
import Footer from '../components/Footer.astro';
import FormattedDate from '../components/FormattedDate.astro';
import Header from '../components/Header.astro';
import Comments from '../components/Comments.astro';
import MoveToDraftButton from '../components/MoveToDraftButton.astro';

interface Props {
	title: string;
	createdAt?: Date;
	updatedAt?: Date;
	thumbnailUrl?: string | null;
	content?: string;
	errorMessage?: string;
	postId?: string;
	isLoggedIn?: boolean;
	isAuthor?: boolean;
}

const { title, createdAt, updatedAt, thumbnailUrl, content, errorMessage, postId, isLoggedIn = false, isAuthor = false } = Astro.props;
---

<html lang="en">
	<head>
		<BaseHead title={title} description={title} />
		<style>
			.hero-image {
				width: 100%;
			}
			.hero-image img {
				display: block;
				margin: 0 auto;
				border-radius: 12px;
				box-shadow: var(--box-shadow);
			}
		</style>
	</head>

	<body>
		<Header isLoggedIn={isLoggedIn} />
		<main class="post-page">
			{errorMessage ? (
				<div class="post-prose"><FetchError message={errorMessage} /></div>
			) : (
			<article>
				<div class="hero-image">
					{thumbnailUrl && <img width="1020" height="510" src={thumbnailUrl} alt="" />}
				</div>
				<div class="post-prose">
					<div class="post-header">
						<h1 class="post-title">{title}</h1>
						<div class="post-meta">
							{createdAt && <div class="post-metadata">Created on <FormattedDate date={createdAt} includeTime /></div>}
							{updatedAt && <div class="post-metadata">Last updated on <FormattedDate date={updatedAt} includeTime /></div>}
						</div>
						{isAuthor && postId && <MoveToDraftButton postId={postId} />}
						<hr />
					</div>
					{content && <div class="markdown-content" set:html={content} />}
					{postId && <Comments postId={postId} />}
				</div>
			</article>
			)}
		</main>
		<Footer />
	</body>
</html>
