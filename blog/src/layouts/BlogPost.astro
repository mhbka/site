---
import BaseHead from '../components/BaseHead.astro';
import FetchError from '../components/FetchError.astro';
import FormattedDate from '../components/FormattedDate.astro';
import PageLayout from '../components/PageLayout.astro';
import Comments from '../components/Comments.astro';
import MoveToDraftButton from '../components/MoveToDraftButton.astro';
import PageTitle from '../components/PageTitle.astro';
import Link from '../components/ui/Link.astro';

interface Props {
	title: string;
	createdAt?: Date;
	publishedAt?: Date;
	updatedAt?: Date;
	thumbnailUrl?: string | null;
	content?: string;
	errorMessage?: string;
	postId?: string;
	isLoggedIn?: boolean;
	isAuthor?: boolean;
}

const { title, createdAt, publishedAt, updatedAt, thumbnailUrl, content, errorMessage, postId, isLoggedIn = false, isAuthor = false } = Astro.props;
---

<html lang="en">
	<head>
		<BaseHead title={title} description={title} />
		<style>
			.hero-image {
				width: 100%;
			}
			.hero-image img {
				display: block;
				margin: 0 auto;
				border-radius: var(--radius-panel);
				box-shadow: var(--shadow-page);
			}
			.post-actions {
				display: flex;
				flex-wrap: wrap;
				gap: 0.75rem;
			}
		</style>
	</head>

	<body>
		<PageLayout isLoggedIn={isLoggedIn} mainClass="post-page">
			{errorMessage ? (
				<div><FetchError message={errorMessage} /></div>
			) : (
			<article>
				<div class="hero-image">
					{thumbnailUrl && <img width="1020" height="510" src={thumbnailUrl} alt="" />}
				</div>
				<div>
					<div class="post-header">
						<PageTitle title={title} className="post-title title-wave" />
						<div class="post-meta">
							{createdAt && <div class="post-metadata">Created on <FormattedDate date={createdAt} includeTime /></div>}
							{publishedAt && <div class="post-metadata">Published on <FormattedDate date={publishedAt} includeTime /></div>}
							{updatedAt && <div class="post-metadata">Last updated on <FormattedDate date={updatedAt} includeTime /></div>}
							{isAuthor && postId && (
								<div class="post-actions">
									<Link class="ui-button" href={`/posts/edit/${postId}/`}>edit</Link>
									<MoveToDraftButton postId={postId} />
								</div>
							)}
						</div>
						<hr />
					</div>
					{content && <div class="markdown-content" set:html={content} />}
					{postId && <Comments postId={postId} />}
				</div>
			</article>
			)}
		</PageLayout>
	</body>
</html>
