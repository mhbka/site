---
import BaseHead from '../components/BaseHead.astro';
import FetchError from '../components/FetchError.astro';
import Footer from '../components/Footer.astro';
import FormattedDate from '../components/FormattedDate.astro';
import Header from '../components/Header.astro';
import Comments from '../components/Comments.astro';

interface Props {
	title: string;
	publishedAt?: Date;
	updatedAt?: Date;
	thumbnailUrl?: string | null;
	content?: string;
	errorMessage?: string;
	postId?: string;
}

const { title, publishedAt, updatedAt, thumbnailUrl, content, errorMessage, postId } = Astro.props;
---

<html lang="en">
	<head>
		<BaseHead title={title} description={title} />
		<style>
			.hero-image {
				width: 100%;
			}
			.hero-image img {
				display: block;
				margin: 0 auto;
				border-radius: 12px;
				box-shadow: var(--box-shadow);
			}
		</style>
	</head>

	<body>
		<Header />
		<main class="post-page">
			{errorMessage ? (
				<div class="post-prose"><FetchError message={errorMessage} /></div>
			) : (
			<article>
				<div class="hero-image">
					{thumbnailUrl && <img width="1020" height="510" src={thumbnailUrl} alt="" />}
				</div>
				<div class="post-prose">
					<div class="post-header">
						<div class="post-meta">
							{publishedAt && <FormattedDate date={publishedAt} />}
							{
								updatedAt && publishedAt && updatedAt.valueOf() !== publishedAt.valueOf() && (
									<div class="post-meta__updated">
										Last updated on <FormattedDate date={updatedAt} />
									</div>
								)
							}
						</div>
						<h1>{title}</h1>
						<hr />
					</div>
					{content && <div class="markdown-content" set:html={content} />}
					{postId && <Comments postId={postId} />}
				</div>
			</article>
			)}
		</main>
		<Footer />
	</body>
</html>
