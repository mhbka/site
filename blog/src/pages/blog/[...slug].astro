---
import BlogPost from '../../layouts/BlogPost.astro';
import { blogApi } from '../../lib/api.ts';
import { fetchResult } from '../../lib/fetch-result.ts';
import { renderMarkdown } from '../../lib/markdown.ts';
import { createSupabaseServerClient } from '../../lib/auth/supabase.ts';

const result = await fetchResult(
	() => blogApi.getPost(Astro.params.slug ?? ''),
	'We could not load this blog post. Please try again shortly.',
);
const post = result.data;
const content = post ? await renderMarkdown(post.contentMd) : undefined;
const publishedAt = post ? new Date(post.publishedAt ?? post.createdAt) : undefined;
const supabaseClient = createSupabaseServerClient(Astro.request, Astro.cookies);
const { data: { session } } = await supabaseClient.auth.getSession();
const isLoggedIn = Boolean(session);
let isAuthor = false;

if (session) {
	try {
		isAuthor = (await blogApi.getAuthorStatus(session.access_token)).isAuthor;
	} catch (error) {
		console.warn(`Failed to fetch isAuthor: ${error}`);
	}
}
---

<BlogPost
	title={post?.title ?? 'Blog post unavailable'}
	publishedAt={publishedAt}
	updatedAt={post ? new Date(post.updatedAt) : undefined}
	thumbnailUrl={post?.thumbnailUrl}
	content={content}
	errorMessage={result.error}
	postId={post?.id}
	isLoggedIn={isLoggedIn}
	isAuthor={isAuthor}
/>
