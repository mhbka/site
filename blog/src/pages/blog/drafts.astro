---
import BaseHead from '../../components/BaseHead.astro';
import FetchError from '../../components/FetchError.astro';
import FormattedDate from '../../components/FormattedDate.astro';
import PageLayout from '../../components/PageLayout.astro';
import { blogApi } from '../../lib/api.ts';
import { createSupabaseServerClient } from '../../lib/auth/supabase.ts';
import { fetchResult, type FetchResult } from '../../lib/fetch-result.ts';
import type { DraftPostSummary } from '../../lib/models/posts.ts';
import Button from '../../components/ui/Button.astro';
import Link from '../../components/ui/Link.astro';

const supabaseClient = createSupabaseServerClient(Astro.request, Astro.cookies);
const { data: { session }, error } = await supabaseClient.auth.getSession();
const isLoggedIn = Boolean(session);
let isAuthor = false;
let draftsResult: FetchResult<DraftPostSummary[]> | undefined;

if (session) {
	try {
		isAuthor = (await blogApi.getAuthorStatus(session.access_token)).isAuthor;
		if (isAuthor) {
			draftsResult = await fetchResult(
				() => blogApi.listDrafts(session.access_token),
				'We could not load your drafts. Please try again shortly.',
			);
		}
	} catch (e) {
		console.warn(`Failed to load drafts: ${e}`);
	}
} else {
	console.warn(`Unable to get session; error: ${error}`);
}
---

<!doctype html>
<html lang="en">
	<head>
		<BaseHead title={"drafts"}  />
		<style>
			.page-actions, .draft-actions { display: flex; gap: 0.75rem; }
			.page-actions { margin-bottom: 2rem; }
			ul { display: grid; gap: 2rem; list-style: none; margin: 0; padding: 0; }
			li { width: 100%; text-align: left; }
			.draft-card { display: block; text-decoration: none; }
			img { width: 100%; margin-bottom: 0.5rem; border-radius: 12px; }
			.title { margin: 0; color: var(--color-heading); line-height: 1; }
			.date { margin: 0.5rem 0; color: var(--color-muted); }
			.draft-card:hover .title { color: var(--color-accent); }
			.empty { color: var(--color-muted); }
			.confirm-dialog {
				--dialog-surface: var(--color-surface);
				--dialog-text: var(--color-heading);
				--dialog-backdrop: var(--color-overlay);
				width: min(32rem, calc(100% - 2rem));
				padding: 0;
				border: 0;
				border-radius: 12px;
				background: var(--dialog-surface);
				color: var(--dialog-text);
			}
			.confirm-dialog::backdrop { background: var(--dialog-backdrop); }
			.confirm-dialog__content { padding: 1.5rem; }
			.confirm-dialog__title, .confirm-dialog__message { margin: 0; }
			.confirm-dialog__message { margin-top: 0.75rem; }
			.confirm-dialog__actions { display: flex; justify-content: flex-end; gap: 0.75rem; margin-top: 1.5rem; }
			.confirm-dialog__cancel { background: var(--color-subtle); color: var(--color-heading); }
			.confirm-dialog__error { min-height: 1.5rem; margin: 0.75rem 0 0; color: var(--color-danger); }
			@media (max-width: 720px) {
				.page-actions, .draft-actions { flex-wrap: wrap; }
			}
		</style>
	</head>
	<body>
		<PageLayout isLoggedIn={isLoggedIn} title="drafts" titleClass="title-wave">
			{isAuthor ? (
					<>
						<div class="page-actions">
							<Link class="action ui-button" href="/posts/new/">create post</Link>
							<Link class="action ui-button" href="/blog/">view published posts</Link>
						</div>
						{draftsResult?.error ? (
							<FetchError message={draftsResult.error} />
						) : draftsResult?.data?.length ? (
							<ul id="draft-list">
								{draftsResult.data.map((post) => (
									<li data-draft-id={post.id}>
									<Link class="draft-card" href={`/posts/edit/${post.id}/`}>
											{post.thumbnailUrl && <img width="720" height="360" src={post.thumbnailUrl} alt="" />}
											<h4 class="title">{post.title}</h4>
											<p class="date">Updated <FormattedDate date={new Date(post.updatedAt)} /></p>
									</Link>
										<div class="draft-actions">
										<Link class="action ui-button" href={`/posts/edit/${post.id}/`}>edit</Link>
										<Button class="publish-button" type="button" data-publish-id={post.id}>publish</Button>
										<Button class="delete-button" type="button" data-delete-id={post.id} data-delete-title={post.title}>delete</Button>
										</div>
									</li>
								))}
							</ul>
						) : (
							<p class="empty">You do not have any drafts yet.</p>
						)}
						<dialog class="confirm-dialog" id="delete-dialog" aria-labelledby="delete-dialog-title">
							<div class="confirm-dialog__content">
								<h2 class="confirm-dialog__title" id="delete-dialog-title">delete draft?</h2>
								<p class="confirm-dialog__message">This will remove “<span id="delete-draft-title"></span>”.</p>
								<p class="confirm-dialog__error" id="delete-error" role="alert"></p>
								<div class="confirm-dialog__actions">
									<Button class="action confirm-dialog__cancel" type="button" id="cancel-delete">cancel</Button>
									<Button class="delete-button" type="button" id="confirm-delete">delete</Button>
								</div>
							</div>
						</dialog>
					</>
			) : (
				<p>You must be logged in with author access to view drafts.</p>
			)}
		</PageLayout>
		<script>
			import { blogApi } from '../../lib/api.ts';
			import { createSupabaseBrowserClient } from '../../lib/auth/supabase.ts';

			const dialog = document.querySelector<HTMLDialogElement>('#delete-dialog');
			const title = document.querySelector<HTMLElement>('#delete-draft-title');
			const error = document.querySelector<HTMLElement>('#delete-error');
			const confirmButton = document.querySelector<HTMLButtonElement>('#confirm-delete');
			let draftId: string | undefined;

			document.querySelectorAll<HTMLButtonElement>('[data-publish-id]').forEach((button) => {
				button.addEventListener('click', async () => {
					const draftId = button.dataset.publishId;
					if (!draftId) return;

					button.disabled = true;
					try {
						const { data: { session } } = await createSupabaseBrowserClient().auth.getSession();
						if (!session) throw new Error('Your session has expired. Please sign in again.');
						await blogApi.publishPost(draftId, session.access_token);
						document.querySelector(`[data-draft-id="${CSS.escape(draftId)}"]`)?.remove();
					} catch (caughtError) {
						window.alert(caughtError instanceof Error ? caughtError.message : 'Unable to publish this draft.');
						button.disabled = false;
					}
				});
			});

			document.querySelectorAll<HTMLButtonElement>('[data-delete-id]').forEach((button) => {
				button.addEventListener('click', () => {
					draftId = button.dataset.deleteId;
					if (title) title.textContent = button.dataset.deleteTitle ?? 'this draft';
					if (error) error.textContent = '';
					dialog?.showModal();
				});
			});

			document.querySelector('#cancel-delete')?.addEventListener('click', () => dialog?.close());
			confirmButton?.addEventListener('click', async () => {
				if (!draftId || !confirmButton) return;
				confirmButton.disabled = true;
				try {
					const { data: { session } } = await createSupabaseBrowserClient().auth.getSession();
					if (!session) throw new Error('Your session has expired. Please sign in again.');
					await blogApi.deletePost(draftId, session.access_token);
					document.querySelector(`[data-draft-id="${CSS.escape(draftId)}"]`)?.remove();
					dialog?.close();
				} catch (caughtError) {
					if (error) error.textContent = caughtError instanceof Error ? caughtError.message : 'Unable to delete this draft.';
				} finally {
					confirmButton.disabled = false;
				}
			});
		</script>
	</body>
</html>
