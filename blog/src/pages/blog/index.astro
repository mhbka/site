---
import BaseHead from '../../components/BaseHead.astro';
import PageLayout from '../../components/PageLayout.astro';
import FetchError from '../../components/FetchError.astro';
import Pagination from '../../components/Pagination.astro';
import PostList from '../../components/PostList.astro';
import TagFilter from '../../components/TagFilter.astro';
import Link from '../../components/ui/Link.astro';
import { blogApi } from '../../lib/api.ts';
import { fetchResult } from '../../lib/fetch-result.ts';
import { getPageAuth } from '../../lib/page-auth.ts';
import { parsePage } from '../../lib/pagination.ts';
import { normalizeTag } from '../../lib/tags.ts';

const pageSize = 20;
const page = parsePage(Astro.url.searchParams.get('page'));
const selectedTag = normalizeTag(Astro.url.searchParams.get('tag') ?? '') || undefined;
const [result, tagsResult] = await Promise.all([
	fetchResult(
	() => blogApi.listPosts(page, pageSize + 1, selectedTag),
	'We could not load the blog posts. Please try again shortly.',
),
	fetchResult(
	() => blogApi.listTags(),
	'We could not load the blog tags. Please try again shortly.',
),
]);
const posts = result.data?.slice(0, pageSize) ?? [];
const hasNext = (result.data?.length ?? 0) > pageSize;
const tags = tagsResult.data ?? [];

const { isLoggedIn, isAuthor } = await getPageAuth(Astro.request, Astro.cookies, { includeAuthor: true });
---

<!doctype html>
<html lang="en">
	<head>
		<BaseHead title={"blog"}  />
	</head>
	<body>
		<PageLayout isLoggedIn={isLoggedIn} title="blog" titleClass="title-wave">
			{isAuthor && (
				<div class="action-group">
					<Link class="ui-button" href="/posts/new/">create post</Link>
					<Link class="ui-button" href="/blog/drafts/">view drafts</Link>
				</div>
			)}
			{result.error ? (
				<FetchError message={result.error} />
			) : (
				<>
					<TagFilter tags={tags} selectedTag={selectedTag} />
					<PostList posts={posts} variant="published" isAuthor={isAuthor} pageSize={pageSize} />
				<Pagination page={page} hasNext={hasNext} tag={selectedTag} />
				</>
			)}
		</PageLayout>
	</body>
</html>
