---
import BaseHead from '../../components/BaseHead.astro';
import Footer from '../../components/Footer.astro';
import FormattedDate from '../../components/FormattedDate.astro';
import Header from '../../components/Header.astro';
import FetchError from '../../components/FetchError.astro';
import Link from '../../components/ui/Link.astro';
import { SITE_DESCRIPTION, SITE_TITLE } from '../../consts';
import { blogApi } from '../../lib/api.ts';
import { createSupabaseServerClient } from '../../lib/auth/supabase.ts';
import { fetchResult } from '../../lib/fetch-result.ts';

const result = await fetchResult(
	() => blogApi.listPosts(1, 100),
	'We could not load the blog posts. Please try again shortly.',
);

const supabaseClient = createSupabaseServerClient(Astro.request, Astro.cookies);
const { data: { session }, error } = await supabaseClient.auth.getSession();
let isAuthor = false;

if (session) {
	try {
		isAuthor = (await blogApi.getAuthorStatus(session.access_token)).isAuthor;
	} catch (e) {
		console.warn(`Failed to fetch isAuthor: ${e}`);
	}
} else {
	console.warn(`Unable to get session; error: ${error}`)
}
---

<!doctype html>
<html lang="en">
	<head>
		<BaseHead title={SITE_TITLE} description={SITE_DESCRIPTION} />
		<style>
			main {
				width: 960px;
			}
			ul {
				display: grid;
				gap: 2rem;
				list-style-type: none;
				margin: 0;
				padding: 0;
			}
			ul li {
				width: 100%;
				text-align: left;
			}
			ul li * {
				text-decoration: none;
				transition: 0.2s ease;
			}
			ul li img {
				margin-bottom: 0.5rem;
				border-radius: 12px;
			}
			ul li a {
				display: block;
			}
			.title {
				margin: 0;
				color: rgb(var(--black));
				line-height: 1;
			}
			.date {
				margin: 0;
				color: rgb(var(--gray));
			}
			ul li a:hover h4,
			ul li a:hover .date {
				color: rgb(var(--accent));
			}
			ul a:hover img {
				box-shadow: var(--box-shadow);
			}
			.post-actions {
				display: flex;
				gap: 0.75rem;
				margin-bottom: 2rem;
			}
			@media (max-width: 720px) {
				ul {
					gap: 0.5em;
				}
			}
		</style>
	</head>
	<body>
		<Header />
		<main>
			<section>
				{isAuthor && (
					<div class="post-actions">
						<Link class="post-action ui-button" href="/posts/new/">Create Post</Link>
						<Link class="post-action ui-button" href="/blog/drafts/">View drafts</Link>
					</div>
				)}
				{result.error ? (
					<FetchError message={result.error} />
				) : (
					<ul>
						{result.data?.map((post) => (
							<li>
								<Link href={`/blog/${post.slug}/`}>
									{post.thumbnailUrl && (
										<img width="720" height="360" src={post.thumbnailUrl} alt="" />
									)}
									<h4 class="title">{post.title}</h4>
									<p class="date">
										<FormattedDate date={new Date(post.publishedAt)} />
									</p>
								</Link>
							</li>
						))}
					</ul>
				)}
			</section>
		</main>
		<Footer />
	</body>
</html>
