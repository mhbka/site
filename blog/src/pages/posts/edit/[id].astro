---
import BaseHead from '../../../components/BaseHead.astro';
import PageLayout from '../../../components/PageLayout.astro';
import PostEditor from '../../../components/PostEditor.astro';
import { blogApi } from '../../../lib/api.ts';
import { createSupabaseServerClient } from '../../../lib/auth/supabase.ts';
import type { Post } from '../../../lib/models/posts.ts';

const supabaseClient = createSupabaseServerClient(Astro.request, Astro.cookies);
const { data: { session } } = await supabaseClient.auth.getSession();
const isLoggedIn = Boolean(session);
let post: Post | undefined;

if (session) {
	try {
		const { isAuthor } = await blogApi.getAuthorStatus(session.access_token);
		if (isAuthor) post = await blogApi.getPostById(Astro.params.id ?? '', session.access_token);
	} catch (error) {
		console.warn(`Unable to load post for editing: ${error}`);
	}
}
---

<!doctype html>
<html lang="en">
	<head>
		<BaseHead title={"edit post"}  />
	</head>
	<body>
		<PageLayout isLoggedIn={isLoggedIn} mainClass="post-page">
			{post ? <PostEditor post={post} /> : <p>This post could not be found or you do not have access to edit it.</p>}
		</PageLayout>
	</body>
</html>
