---
import BaseHead from '../../../components/BaseHead.astro';
import PageLayout from '../../../components/PageLayout.astro';
import PostEditor from '../../../components/PostEditor.astro';
import { blogApi } from '../../../lib/api.ts';
import { getPageAuth } from '../../../lib/page-auth.ts';
import type { Post } from '../../../lib/models/posts.ts';

const { isLoggedIn, isAuthor, accessToken } = await getPageAuth(Astro.request, Astro.cookies, { includeAuthor: true });
let post: Post | undefined;

if (isAuthor && accessToken) {
	try {
		post = await blogApi.getPostById(Astro.params.id ?? '', accessToken);
	} catch (error) {
		console.warn(`Unable to load post for editing: ${error}`);
	}
}
---

<!doctype html>
<html lang="en">
	<head>
		<BaseHead title={"edit post"}  />
	</head>
	<body>
		<PageLayout isLoggedIn={isLoggedIn} mainClass="post-page">
			{post ? <PostEditor post={post} /> : <p>This post could not be found or you do not have access to edit it.</p>}
		</PageLayout>
	</body>
</html>
