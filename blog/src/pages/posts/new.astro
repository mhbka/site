---
import BaseHead from '../../components/BaseHead.astro';
import PageLayout from '../../components/PageLayout.astro';
import PostEditor from '../../components/PostEditor.astro';
import { blogApi } from '../../lib/api.ts';
import { createSupabaseServerClient } from '../../lib/auth/supabase.ts';

const supabaseClient = createSupabaseServerClient(Astro.request, Astro.cookies);
const { data: { session } } = await supabaseClient.auth.getSession();
const isLoggedIn = Boolean(session);
let isAuthor = false;

if (session) {
	try {
		isAuthor = (await blogApi.getAuthorStatus(session.access_token)).isAuthor;
	} catch (error) {
		console.warn(`Unable to verify post author access: ${error}`);
	}
}
---

<!doctype html>
<html lang="en">
	<head>
		<BaseHead title={"create post"}  />
	</head>
	<body>
		<PageLayout isLoggedIn={isLoggedIn} mainClass="post-page">
			{isAuthor ? <PostEditor /> : <p>You must be logged in with author access to create a post.</p>}
		</PageLayout>
	</body>
</html>
